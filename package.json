{
  "name": "dsh-sts2",
  "version": "0.4.7",
  "private": false,
  "type": "module",
  "description": "Play Slay the Spire 2 through the STS2 AI Agent local HTTP API: state and action tools with automatic port discovery and a per-profile safety check.",
  "icon": "icon.svg",
  "author": "OrdinaryTu",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "autoplay.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "slay-the-spire-2",
    "sts2",
    "game"
  ],
  "license": "MIT"
